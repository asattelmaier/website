cabal-version:       3.0
name:                website
version:             0.1.0.0
synopsis:            sattelmaier.info website
homepage:            https://github.com/asattelmaier/website
license:             BSD-3-Clause
license-file:        LICENSE
author:              Alexander Sattelmaier
maintainer:          alexander@sattelmaier.info
category:            Web
build-type:          Simple
extra-source-files:
  CHANGELOG.md,
  README.md,
  .stylish-haskell.yaml

executable website
  main-is:               Main.hs
  default-language:      Haskell2010
  hs-source-dirs:        src
  ghc-options:           -Wall -Wunused-packages
  
  other-modules:
    Server.Config,
    Server.Controller,
    Server.Main

  build-depends:
    base                 ^>=4.22.0.0,
    bytestring           ^>=0.12.2.0,
    directory            ^>=1.3.10.0,
    snap-core            ^>=1.0.5.1,
    snap-server          ^>=1.1.2.1

source-repository head
  type:     git
  location: https://github.com/asattelmaier/website.git

